# Database
DATABASE_URL=mysql://user:password@localhost:3306/openhouse

# JWT
JWT_SECRET=your-jwt-secret-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000
API_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Domain API (https://developer.domain.com.au)
DOMAIN_CLIENT_ID=your-domain-client-id
DOMAIN_CLIENT_SECRET=your-domain-client-secret
DOMAIN_AUTH_URL=https://auth.domain.com.au/v1/connect/token
DOMAIN_API_BASE_URL=https://api.domain.com.au/v1

# mock uses local sample listings. domain calls the Domain API.
PROPERTY_DATA_SOURCE=mock